<bpmn2:sequenceFlow id="SF_1" sourceRef="StartEvent_1" targetRef="CallActivity_1"/><bpmn2:sequenceFlow id="SF_2" sourceRef="CallActivity_1" targetRef="EndEvent_1"/>
